{
  "name": "advisor-bulletin",
  "version": "1.0.0",
  "description": "EBHCS Advisor Bulletin Board",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build:snapshot": "node scripts/build-student-feed-snapshot.mjs",
    "prebuild": "npm run build:snapshot && node scripts/check-resource-categories-sync.mjs && node scripts/check-admin-emails-sync.mjs && node scripts/check-csp-sync.mjs && node scripts/check-resource-freshness.mjs",
    "build": "vite build",
    "deploy": "npm run build && firebase deploy",
    "preview": "vite preview",
    "test": "node scripts/run-with-emulator.mjs -- playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:mobile": "node scripts/run-with-emulator.mjs -- playwright test --project=mobile",
    "test:ui": "node scripts/run-with-emulator.mjs -- playwright test --ui",
    "test:headed": "node scripts/run-with-emulator.mjs -- playwright test --headed",
    "export:industry-pdf": "node scripts/export-industry-report-pdf.mjs",
    "import:resources": "node scripts/import-resources.mjs",
    "check:chips": "node scripts/check-chip-translations.mjs",
    "check:resource-content": "node scripts/check-resource-content-risk.mjs",
    "check:resource-links": "node scripts/check-resource-links.mjs",
    "clear:analytics": "node scripts/clear-analytics-events.mjs --dry-run",
    "clear:analytics:confirm": "node scripts/clear-analytics-events.mjs --confirm",
    "prune:errors": "node scripts/prune-client-errors.mjs --dry-run",
    "prune:errors:confirm": "node scripts/prune-client-errors.mjs --confirm"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.5.1",
    "vite": "^8.0.11"
  }
}
